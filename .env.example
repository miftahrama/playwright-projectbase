# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Test Environment
# Options: staging, production
# ============================================
ENV=staging

# ============================================
# Base URLs (override environment defaults)
# ============================================
# Staging: https://portal-sekolah.com
# Production: https://portalsekolah.com
# BASE_URL=https://portal-sekolah.com
# DASHBOARD_URL=https://dashboard.portal-sekolah.com/

# ============================================
# Browser settings
# Options: chromium, firefox, webkit
# ============================================
BROWSER=chromium
HEADLESS=false

# ============================================
# Timeout settings (milliseconds)
# ============================================
TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# ============================================
# Default test data
# ============================================
DEFAULT_SCHOOL_SEARCH=smp - q
DEFAULT_SCHOOL_NAME=SMP - QA Demo School
DEFAULT_USERNAME=adminsmp.123
DEFAULT_PASSWORD=password123*

# ============================================
# Screenshot settings
# ============================================
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=test-results/screenshots